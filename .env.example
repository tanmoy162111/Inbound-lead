PORT=3000
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/lead_intake
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/lead_intake_test
# HMAC secret shared with lead senders (generate: openssl rand -hex 32)
WEBHOOK_SECRET=change-me
LOG_LEVEL=info
# Optional: where accepted leads are delivered (CRM/Zapier/n8n/Slack relay). Unset = log only.
#DESTINATION_URL=https://example.com/hook
#DESTINATION_TOKEN=
RATE_LIMIT_MAX=120
OUTBOX_MAX_ATTEMPTS=8
# Raw webhook payloads (PII) are redacted after this many days
RAW_RETENTION_DAYS=30
# Set true only when behind a trusted reverse proxy (so rate limiting sees client IPs)
TRUST_PROXY=false
